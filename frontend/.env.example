# Copy to frontend/.env — Expo loads EXPO_PUBLIC_* at build time.
# Restart Metro after changes: npx expo start -c

# Supabase (Dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional Vite/web aliases (same values):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# FastAPI (same Wi-Fi as phone; or leave unset to auto-detect from Metro)
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8000
