# Copy to .env in this directory (repo root).
#
# IMPORTANT: "Direct connection" (db.PROJECT_REF.supabase.co) is IPv6-only.
# On many Mac/Wi-Fi networks you get: "could not translate host name ... to address"
# even with the correct password. Use the Session pooler string instead:
#
# Dashboard → Connect → Session pooler → URI (port 5432)
# Example shape:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Do NOT paste the publishable/anon key here — that is for the JS client only.

DATABASE_URL=

APP_NAME=Ike - Task Landscape API

# Supabase project URL (same as EXPO_PUBLIC_SUPABASE_URL) — JWKS for ES256 tokens
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase → Settings → API → Legacy JWT Secret (HS256, optional if using ES256 only)
SUPABASE_JWT_SECRET=

# Optional sign-in allowlist (comma-separated Google emails). Leave empty for open sign-up.
# Also see the `allowed_emails` table in supabase/migrations/001_auth_profiles.sql.
# ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
